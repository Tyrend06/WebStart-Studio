# Kopieer dit bestand naar ".env" en vul je eigen waarden in.
# Zet ".env" NOOIT op GitHub (staat al in .gitignore).

# ---- Algemeen ----
PORT=3000
NODE_ENV=development
# De publieke URL van je site (bij hosting: je echte domein)
BASE_URL=http://localhost:3000

# ---- E-mail (contactformulier + afspraakbevestigingen) ----
# Berichten van bezoekers komen binnen op dit adres:
OWNER_EMAIL=marentleynunez@gmail.com

# Gmail SMTP. Maak een "App-wachtwoord" aan in je Google-account
# (Beveiliging > Verificatie in twee stappen > App-wachtwoorden).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=marentleynunez@gmail.com
SMTP_PASS=
# Afzendernaam (optioneel)
MAIL_FROM="Webstart Studio <marentleynunez@gmail.com>"

# ---- Google Meet / Agenda ----
# Zie README.md, stap "Google Meet koppelen"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ---- Social media (footer) ----
SOCIAL_INSTAGRAM=https://www.instagram.com/
SOCIAL_FACEBOOK=https://www.facebook.com/
SOCIAL_LINKEDIN=https://www.linkedin.com/
SOCIAL_TIKTOK=https://www.tiktok.com/
