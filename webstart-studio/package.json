{
  "name": "webstart-studio",
  "version": "1.0.0",
  "description": "Bedrijfswebsite van Webstart Studio (TypeScript, Express, MVC)",
  "main": "dist/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:client && tsx watch src/server.ts",
    "dev:client": "tsc -p tsconfig.client.json --watch",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "google-token": "tsx scripts/get-google-token.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "googleapis": "^144.0.0",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
