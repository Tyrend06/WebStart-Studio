<div style="font-family:Arial,Helvetica,sans-serif;color:#000;max-width:560px;margin:0 auto;">
  <h2 style="margin:0 0 16px;">Nieuw bericht via je website</h2>
  <p style="margin:0 0 4px;"><strong>Naam:</strong> <%= name %></p>
  <p style="margin:0 0 16px;"><strong>E-mail:</strong> <a href="mailto:<%= email %>"><%= email %></a></p>
  <div style="border-left:4px solid #000;padding:8px 16px;background:#f4f4f4;white-space:pre-wrap;"><%= message %></div>
  <p style="margin-top:16px;color:#555;font-size:13px;">Je kunt direct op deze e-mail antwoorden: het antwoord gaat naar <%= email %>.</p>
</div>
