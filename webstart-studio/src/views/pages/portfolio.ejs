<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="page-hero" aria-labelledby="page-title">
  <div class="container">
    <p class="eyebrow">Portfolio</p>
    <h1 id="page-title">Onze klanten</h1>
    <p class="page-lead">Websites die wij hebben gemaakt. Klik op een project om de live website te bekijken.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (items.length === 0) { %>
      <!-- Geen klanten: duidelijke melding in plaats van een lege pagina -->
      <div class="empty-state" role="status">
        <div class="empty-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 9h18M8 21h8M12 18v3"/></svg>
        </div>
        <h2>Nog geen klanten in ons portfolio</h2>
        <p>Webstart Studio is net gestart. Onze eerste projecten verschijnen hier zodra ze live zijn.</p>
        <p>Wil jij onze eerste klant worden? We denken graag met je mee.</p>
        <a class="btn btn--dark" href="/afspraak">Plan een gratis kennismaking</a>
      </div>
    <% } else { %>
      <ul class="grid grid--3 portfolio-grid">
        <% items.forEach(function (item) { %>
          <li>
            <a class="portfolio-card" href="<%= item.url %>" target="_blank" rel="noopener noreferrer">
              <% if (item.image) { %>
                <img src="<%= item.image %>" alt="Screenshot van de website van <%= item.name %>" loading="lazy">
              <% } else { %>
                <div class="portfolio-placeholder" aria-hidden="true"><%= item.name.charAt(0) %></div>
              <% } %>
              <div class="portfolio-body">
                <% if (item.category) { %><span class="portfolio-category"><%= item.category %></span><% } %>
                <h2><%= item.name %></h2>
                <% if (item.description) { %><p><%= item.description %></p><% } %>
                <span class="portfolio-link">Bekijk website &rarr;</span>
              </div>
            </a>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
